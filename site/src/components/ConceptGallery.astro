---
// ConceptGallery.astro — Phase 1 concept art gallery
const images = [
  { src: '/sunset_stadium_render.png',       alt: 'Sunset Championship Arena',         tag: 'ARENA',  label: 'Sunset Championship' },
  { src: '/forbidden_temple_render.png',      alt: 'Forbidden Temple Arena',              tag: 'ARENA',  label: 'Forbidden Temple' },
  { src: '/forbidden_temple_octane_render.png', alt: 'Forbidden Temple — Octane View',     tag: 'ARENA',  label: 'Temple · Octane View' },
  { src: '/forbidden_temple_action_render.png', alt: 'Forbidden Temple — Action Shot',     tag: 'ARENA',  label: 'Temple · Action' },
  { src: '/forbidden_temple_overdrive_fullview.png', alt: 'Forbidden Temple — Overdrive',  tag: 'ARENA',  label: 'Temple · Overdrive' },
  { src: '/octane_ref.png',                  alt: 'Octane concept reference',             tag: 'REF',    label: 'Octane Concept Ref' },
  { src: '/sunset_arena_ref.png',            alt: 'Sunset Arena reference',               tag: 'REF',    label: 'Sunset Arena Ref' },
  { src: '/car_livery_blueprint.png',        alt: 'Race car livery blueprint',            tag: 'LIVERY', label: 'Race Car Blueprint' },
];

const tagColors: Record<string, string> = {
  ARENA:  'var(--color-primary)',
  REF:    'var(--color-text-mute)',
  LIVERY: 'var(--color-secondary)',
};
---

<section class="section concept-section" id="concept-art">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">Phase 1 · Concept Art</span>
      <h2 class="section-title">World &amp; Arena Concepts</h2>
      <p class="section-sub">
        Photorealistic Rocket League–style stadium concepts and gameplay stills —
        the visual foundation for the League of Rockets world.
      </p>
    </div>

    <div class="gallery-grid">
      {images.map((img, i) => (
        <figure class={`gallery-card reveal reveal-delay-${Math.min(i % 4 + 1, 5)}`}>
          <div class="gallery-media">
            <img
              src={img.src}
              alt={img.alt}
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
              class="gallery-img"
            />
            <div class="gallery-tag" style="color: {tagColors[img.tag]}">{img.tag}</div>
          </div>
          <figcaption class="gallery-caption">{img.label}</figcaption>
        </figure>
      ))}
    </div>

    <!-- Stats strip -->
    <div class="stats-strip reveal reveal-delay-3">
      <div class="stat">
        <div class="stat-value" data-end="3">0</div>
        <div class="stat-label">Arena Concepts</div>
      </div>
      <div class="stat">
        <div class="stat-value" data-end="4">0</div>
        <div class="stat-label">Car Variants</div>
      </div>
      <div class="stat">
        <div class="stat-value" data-end="1" data-prefix="1:">0</div>
        <div class="stat-label">Octane Authentic</div>
      </div>
      <div class="stat">
        <div class="stat-value" data-end="0">0</div>
        <div class="stat-label">Download Required</div>
      </div>
      <div class="stat">
        <div class="stat-value" data-end="0" style="font-size: 1.6em; color: var(--color-secondary);">∞</div>
        <div class="stat-label">Play Sessions</div>
      </div>
    </div>
  </div>
</section>

<style>
  .concept-section { padding: var(--space-24) 0; }

  .section-header {
    margin-bottom: var(--space-12);
    max-width: 680px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .gallery-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    cursor: pointer;
    transition: transform var(--dur-base) var(--ease-out),
                border-color var(--dur-base) var(--ease-out),
                box-shadow var(--dur-base) var(--ease-out);
  }

  .gallery-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-soft);
    box-shadow: var(--shadow-lg);
  }

  .gallery-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface-2);
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease-out);
  }

  .gallery-card:hover .gallery-img {
    transform: scale(1.04);
  }

  .gallery-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    background: rgba(7,7,13,0.6);
    backdrop-filter: blur(6px);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255,255,255,0.06);
  }

  .gallery-caption {
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    color: var(--color-text);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  /* Stats strip */
  .stats-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0;
    margin-top: var(--space-12);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-surface);
  }

  .stat {
    padding: var(--space-5) var(--space-4);
    text-align: center;
    border-right: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }

  .stat:last-child { border-right: none; }

  .stat-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.4rem;
    line-height: 1;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-top: var(--space-2);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .gallery-grid { grid-template-columns: 1fr; }
    .stats-strip { grid-template-columns: repeat(2, 1fr); }
    .stat:nth-child(2) { border-right: none; }
    .stat:nth-child(1), .stat:nth-child(2) { border-bottom: 1px solid var(--color-border); }
  }
</style>
